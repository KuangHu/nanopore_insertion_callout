# Site settings template for Lawrencium. Copy to config/site.env (git-ignored) and replace every
# CHANGE_ME. Check values on the cluster: `sacctmgr show assoc user=$USER format=account,partition,qos`,
# `sinfo -s`, and `sinfo -N -o "%P %c %m %f" | sort -u` for cores, memory and CPU features per partition.
# Format: VAR="${VAR:-value}" so an exported environment variable always overrides the file.

# Data and logs (use group or project storage for the ~1.3 TB IS_cycle tree, not purged scratch)
CYCLE_DATA_ROOT="${CYCLE_DATA_ROOT:-CHANGE_ME/IS_cycle}"
CYCLE_LOG_DIR="${CYCLE_LOG_DIR:-$HOME/logs}"

# Software environment (recreate from envs/, see envs/README.md)
CYCLE_CONDA_ENV="${CYCLE_CONDA_ENV:-opfi}"
CYCLE_ENV_PREFIX="${CYCLE_ENV_PREFIX:-CHANGE_ME/envs/opfi}"

# Reference assets restored from the migration package (assets component)
CYCLE_HMM_DIR="${CYCLE_HMM_DIR:-CHANGE_ME/assets/hmm}"    # DEDD.hmm, Tnp20.hmm (restored by verify_on_target.sh)
CYCLE_GTDB_GENOMES_DIR="${CYCLE_GTDB_GENOMES_DIR:-CHANGE_ME/GTDB/gtdb_genomes_reps_r220}"   # only for sideproject split finder
CYCLE_GTDB_BLASTDB="${CYCLE_GTDB_BLASTDB:-CHANGE_ME/gtdb_blastdb/gtdb_reps_r220}"            # only for sideproject blastn
CYCLE_ECOR_DIR="${CYCLE_ECOR_DIR:-CHANGE_ME/IS110/ECOR_batch}"                               # only for sideproject ECOR runs

# Scheduler (Lawrencium requires an account)
CYCLE_SLURM_ACCOUNT="${CYCLE_SLURM_ACCOUNT:-CHANGE_ME}"
CYCLE_SLURM_PARTITION="${CYCLE_SLURM_PARTITION:-CHANGE_ME}"
CYCLE_SLURM_QOS="${CYCLE_SLURM_QOS:-CHANGE_ME}"
CYCLE_SLURM_CPUS="${CYCLE_SLURM_CPUS:-CHANGE_ME}"     # cores per node of the chosen partition
CYCLE_SLURM_MEM="${CYCLE_SLURM_MEM:-CHANGE_ME}"       # memory per node, e.g. 256G
CYCLE_SLURM_AVX2_EXCLUDE="${CYCLE_SLURM_AVX2_EXCLUDE:-}"   # nodes lacking AVX2, if any (comma list)
CYCLE_SLURM_EXTRA="${CYCLE_SLURM_EXTRA:-}"                 # e.g. --constraint=... if needed
