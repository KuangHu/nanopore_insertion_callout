# Site settings: IGI cluster (igi.biotite). These are exactly the values that were hardcoded in
# the scripts before the 2026-11 migration, so behaviour on IGI is unchanged when no site.env exists.
# Format: VAR="${VAR:-value}" so an exported environment variable always overrides the file.

# Data and logs
CYCLE_DATA_ROOT="${CYCLE_DATA_ROOT:-/groups/rubin/projects/kuang/out/IS_cycle}"
CYCLE_LOG_DIR="${CYCLE_LOG_DIR:-$HOME/logs}"

# Software environment (conda env named opfi; jobs put $CYCLE_ENV_PREFIX/bin first on PATH)
CYCLE_CONDA_ENV="${CYCLE_CONDA_ENV:-opfi}"
CYCLE_ENV_PREFIX="${CYCLE_ENV_PREFIX:-/home/kuangh/miniconda3/envs/opfi}"

# Reference assets that live outside the repository
CYCLE_HMM_DIR="${CYCLE_HMM_DIR:-/home/kuangh/scripts/IS110/hmm}"              # DEDD.hmm, Tnp20.hmm
CYCLE_GTDB_GENOMES_DIR="${CYCLE_GTDB_GENOMES_DIR:-/groups/rubin/databases/GTDB/gtdb_genomes_v2024latest/gtdb_genomes_reps_r220/allfilestogether}"
CYCLE_GTDB_BLASTDB="${CYCLE_GTDB_BLASTDB:-/groups/rubin/projects/kuang/db/gtdb_blastdb/gtdb_reps_r220}"   # no longer on disk (2026-11)
CYCLE_ECOR_DIR="${CYCLE_ECOR_DIR:-/groups/rubin/projects/kuang/out/IS110/ECOR_batch}"

# Scheduler
CYCLE_SLURM_ACCOUNT="${CYCLE_SLURM_ACCOUNT:-}"
CYCLE_SLURM_PARTITION="${CYCLE_SLURM_PARTITION:-standard}"
CYCLE_SLURM_QOS="${CYCLE_SLURM_QOS:-standard}"
# Note: since 2026-10 the IGI 'standard' QOS rejects jobs above 12 CPUs; set CYCLE_SLURM_CPUS=12 if
# batch submissions fail with QOSMaxCpuPerJobLimit.
CYCLE_SLURM_CPUS="${CYCLE_SLURM_CPUS:-48}"
CYCLE_SLURM_MEM="${CYCLE_SLURM_MEM:-192G}"
# Nodes without the CPU features mmseqs2 needs (Phase 3 clustering and some side jobs avoid them)
CYCLE_SLURM_AVX2_EXCLUDE="${CYCLE_SLURM_AVX2_EXCLUDE:-node-48-256g-2,node-48-256g-3,node-48-256g-8,node-48-256g-9,node-48-256g-12,node-48-256g-13,node-48-256g-14,node-48-256g-17,node-48-256g-18,node-48-256g-19,node-48-256g-20}"
CYCLE_SLURM_EXTRA="${CYCLE_SLURM_EXTRA:-}"
